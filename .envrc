# Activate local venv
export CLAUDE_MCP_CONFIG="$PWD/.claude/mcp.json"
export CHINOOK_DB_PATH="$PWD/chinook.db"
if [ -d ".venv" ]; then
  source .venv/bin/activate
fi

# Load secrets from 1Password
export OPENAI_API_KEY="$(op read op://Employee/OpenAI/credential)"
export ANTHROPIC_API_KEY="$(op read op://Employee/Anthropic/credential)"
